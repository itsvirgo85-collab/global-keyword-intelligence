# Global Keyword Intelligence — environment variables
# Copy to .env.local and fill in only the providers you use.
# NEVER commit .env.local. Keys are server-side only (never NEXT_PUBLIC_).

# --- Supabase (PostgreSQL, free tier) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Paid / optional providers (all optional for the free-first MVP) ---
# DataForSEO — keyword volume, CPC, KD, SERP. Pay-per-call, ~$0.05/search.
# https://dataforseo.com — free $1 credit on signup.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Google Ads API — real search volume + CPC. Needs Ads API approval + developer token.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=

# SERP provider (SerpApi / Serper / ScrapingRobot) — live top-10 SERP for the SERP Analyzer.
SERP_API_KEY=
SERP_API_PROVIDER=serpapi

# Google Trends is accessed via pytrends (optional Python worker, see README).
# Google Search Console integration is a future phase — no key needed yet.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
